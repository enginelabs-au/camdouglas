# Optional. Leave unset to use the sample URL in config/scene.ts.
# NEXT_PUBLIC_SCENE_URL=/scenes/studio.spz

# Shared signing secret for the review identity cookie.
AUTH_SECRET=

# Public origin used in OAuth redirects.
# Local: http://localhost:3000
# Production (Vercel): https://camdouglas.com
REVIEW_APP_URL=http://localhost:3000

# GitHub username search works without this. Login needs an OAuth App.
# Homepage: REVIEW_APP_URL
# Local callback: http://localhost:3000/api/reviews/auth/github/callback
# Production callback: https://camdouglas.com/api/reviews/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Sign-In (openid email profile). Uses the name on the Google account.
# Local callback: http://localhost:3000/api/reviews/auth/google/callback
# Production callback: https://camdouglas.com/api/reviews/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn Sign In with LinkedIn using OpenID Connect (openid profile email).
# Local callback: http://localhost:3000/api/reviews/auth/linkedin/callback
# Production callback: https://camdouglas.com/api/reviews/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Review approval inbox. Defaults to cam@enginelabs.com.au
# REVIEW_INBOX=

# Resend is the reliable path. Sign up at https://resend.com, verify
# enginelabs.com.au, then send from that domain:
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=cam@enginelabs.com.au
# REVIEW_FROM=Cam Douglas <cam@enginelabs.com.au>

# Vercel Blob for approved reviews. Linked automatically on Vercel.
# BLOB_READ_WRITE_TOKEN=

# Optional. Protects GET /api/reviews/backup outside Vercel Cron.
# CRON_SECRET=
